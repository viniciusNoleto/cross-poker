# local | homolog | production (escolhe o docker-compose.{APP_ENV}.yml)
APP_ENV=local
# Só no local: porta publicada no host. Em homolog/produção o container não publica porta (fica atrás do NPM).
APP_PORT=3000
# Homolog/produção — rede Docker do Nginx Proxy Manager (o container do app entra nela)
PROXY_NETWORK=nginx-proxy-manager

POSTGRES_DB=cross_poker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Só no local: porta do Postgres publicada no host (usada pelo drizzle-kit rodando no host)
POSTGRES_HOST_PORT=5433

# Dentro do Docker o host/porta do banco são fixados pelo docker-compose
# (cross-poker-postgres:5432). Só preencha se rodar o app fora do Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
